:root{--ink: #111210;--ink-soft: #1a1b18;--paper: #f3f0e8;--paper-light: #faf8f2;--white: #ffffff;--orange: #ff6338;--orange-dark: #d94218;--text: #1a1b18;--muted: #696961;--line: #d1cec5;--dark-line: #32332f;--max: 1440px;--side: clamp(20px, 5vw, 76px);color:var(--text);background:var(--ink);font-family:Helvetica Neue,Helvetica,Arial,sans-serif;font-synthesis:none;text-rendering:optimizeLegibility}*{box-sizing:border-box}html{scroll-behavior:smooth;scroll-padding-top:78px}body{margin:0;min-width:320px;background:var(--ink);color:var(--text);-webkit-font-smoothing:antialiased}button,a{color:inherit;font:inherit}a{text-decoration:none}button{border:0}img{display:block;max-width:100%}p,h1,h2,h3,ul{margin-top:0}button,summary,a{-webkit-tap-highlight-color:transparent}button:focus-visible,summary:focus-visible,a:focus-visible{outline:3px solid var(--orange);outline-offset:4px}.site-shell{overflow:hidden}.site-header{position:sticky;top:0;z-index:50;display:grid;grid-template-columns:1fr auto 1fr;align-items:center;min-height:78px;padding:0 var(--side);border-bottom:1px solid var(--dark-line);background:#111210f7;color:var(--white)}.brand{display:inline-flex;align-items:center;gap:13px;width:max-content}.brand-copy b,.brand-copy small{display:block}.brand-copy b{font-size:.9rem;letter-spacing:.08em;text-transform:uppercase}.brand-copy small{margin-top:3px;color:#aeadab;font-size:.7rem}.site-header nav{display:flex;align-items:center;gap:30px;color:#b9bab5;font-size:.8rem}.site-header nav a{transition:color .16s ease}.site-header nav a:hover{color:var(--white)}.header-cta{justify-self:end;padding:12px 16px;border:1px solid #4b4c47;font-size:.78rem;font-weight:700;transition:border-color .16s ease,color .16s ease}.header-cta:hover{border-color:var(--orange);color:var(--orange)}.section-dark{background:var(--ink);color:var(--white)}.section-light{background:var(--paper);color:var(--text)}.section-paper{background:var(--paper-light);color:var(--text)}.section-accent{background:var(--orange);color:var(--ink)}.hero{display:grid;grid-template-columns:minmax(0,1.07fr) minmax(390px,.93fr);gap:clamp(42px,6vw,92px);align-items:center;min-height:630px;padding:54px var(--side) 62px}.hero-copy{max-width:820px}.eyebrow{display:flex;gap:16px;align-items:center;margin-bottom:24px;color:#b6b7b2;font-family:ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,monospace;font-size:.72rem;font-weight:700;letter-spacing:.1em;text-transform:uppercase}.eyebrow span{color:var(--orange)}.dark-eyebrow{color:var(--muted)}.hero h1,.problem-heading h2,.projects-heading h2,.deliverables-heading h2,.final-cta h2{margin-bottom:0;font-size:clamp(3.35rem,6.2vw,5.9rem);font-weight:630;letter-spacing:-.065em;line-height:.95}h1 em,h2 em{color:var(--orange);font-family:Georgia,Times New Roman,serif;font-weight:400}.hero-lead{max-width:690px;margin:28px 0 0;color:#c4c5c0;font-size:clamp(1.04rem,1.5vw,1.22rem);line-height:1.65}.hero-actions{display:flex;flex-wrap:wrap;gap:26px;align-items:center;margin-top:34px}.hero-assurance{margin:18px 0 0;color:#9fa09b;font-size:.76rem}.hero-assurance b{color:var(--white)}.button{display:inline-flex;min-height:52px;align-items:center;justify-content:space-between;gap:28px;padding:0 19px;border:1px solid currentColor;font-size:.84rem;font-weight:800;letter-spacing:.01em;transition:background-color .16s ease,color .16s ease,transform .16s ease}.button:hover{transform:translateY(-2px)}.button-accent{border-color:var(--orange);background:var(--orange);color:var(--ink)}.button-accent:hover{background:#ff7854}.button-dark{border-color:var(--ink);background:var(--ink);color:var(--white)}.button-dark:hover{background:#292a26}.text-link{display:inline-flex;gap:10px;align-items:center;border-bottom:1px solid #777873;padding:8px 0 6px;color:#d3d4cf;font-size:.82rem;font-weight:700}.text-link:hover{border-color:var(--orange);color:var(--orange)}.hero-facts{display:flex;flex-wrap:wrap;gap:11px 26px;margin:28px 0 0;padding:18px 0 0;border-top:1px solid var(--dark-line);color:#aeb0aa;font-size:.75rem;list-style:none}.hero-facts li:before{content:"—";margin-right:8px;color:var(--orange)}.hero-work{position:relative;display:block;max-width:600px;justify-self:end;border:1px solid #3c3d39;background:#171815}.hero-work-design{position:relative;aspect-ratio:16 / 10;overflow:hidden;background:#070806}.hero-work-design img{width:100%;height:100%;object-fit:cover;object-position:left center;transition:transform .42s ease}.hero-work:hover .hero-work-design img{transform:scale(1.018)}.hero-work-caption{display:flex;justify-content:space-between;gap:22px;align-items:center;padding:18px 20px;border-top:1px solid #3c3d39}.hero-work-caption small,.hero-work-caption b{display:block}.hero-work-caption small{margin-bottom:4px;color:#8e8f8a;font-size:.67rem;text-transform:uppercase}.hero-work-caption b,.hero-work-caption>span{font-size:.78rem}.hero-work-caption>span{color:var(--orange);font-weight:700}.proof-strip{display:grid;grid-template-columns:repeat(4,1fr);border-top:1px solid var(--dark-line);border-bottom:1px solid var(--dark-line);background:var(--ink-soft);color:#b5b6b1}.proof-strip span{padding:20px var(--side);border-right:1px solid var(--dark-line);font-family:ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,monospace;font-size:.67rem;letter-spacing:.04em;text-align:center;text-transform:uppercase}.proof-strip span:last-child{border-right:0}.proposal{display:grid;grid-template-columns:minmax(0,1fr) minmax(390px,.72fr);gap:clamp(52px,8vw,130px);align-items:start;padding:88px var(--side) 96px;border-bottom:1px solid var(--line)}.proposal-copy h2{max-width:850px;margin:0;font-size:clamp(3rem,5.2vw,5.4rem);font-weight:620;letter-spacing:-.062em;line-height:.98}.proposal-copy h2 em{color:var(--orange-dark)}.proposal-lead{max-width:760px;margin:28px 0 0;color:var(--muted);font-size:clamp(1rem,1.45vw,1.18rem);line-height:1.68}.proposal-output{display:grid;grid-template-columns:repeat(2,1fr);margin-top:38px;border-top:1px solid #aaa79e;border-left:1px solid #aaa79e}.proposal-output article{min-height:160px;padding:21px;border-right:1px solid #aaa79e;border-bottom:1px solid #aaa79e}.proposal-output article>span{color:var(--orange-dark);font-family:ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,monospace;font-size:.62rem}.proposal-output b{display:block;margin-top:28px;font-size:.9rem}.proposal-output p{margin:8px 0 0;color:var(--muted);font-size:.78rem;line-height:1.55}.proposal-whatsapp{display:inline-flex;gap:14px;align-items:center;margin-top:25px;border-bottom:1px solid #8c8981;padding-bottom:6px;color:#4c4c46;font-size:.8rem;font-weight:700}.proposal-whatsapp:hover{border-color:var(--orange-dark);color:var(--orange-dark)}.proposal-form{scroll-margin-top:96px;display:grid;gap:18px;padding:clamp(26px,3.5vw,44px);border:1px solid #343530;background:var(--ink);color:var(--white);box-shadow:14px 14px #dfdbd1}.proposal-form-heading{margin-bottom:8px;padding-bottom:22px;border-bottom:1px solid var(--dark-line)}.proposal-form-heading>span{color:var(--orange);font-family:ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,monospace;font-size:.64rem;font-weight:700;letter-spacing:.08em;text-transform:uppercase}.proposal-form-heading h3{margin:15px 0 10px;font-size:clamp(1.75rem,2.8vw,2.75rem);font-weight:600;letter-spacing:-.05em;line-height:1.03}.proposal-form-heading p{margin-bottom:0;color:#999a94;font-size:.77rem;line-height:1.55}.proposal-form label{display:grid;gap:8px}.proposal-form label>span{color:#b7b8b2;font-size:.67rem;font-weight:700}.proposal-form input,.proposal-form select{width:100%;min-height:48px;border:1px solid #4c4d48;border-radius:0;outline:0;background:#1b1c19;color:var(--white);font:inherit;font-size:.82rem}.proposal-form input{padding:0 13px}.proposal-form select{padding:0 36px 0 13px}.proposal-form input::placeholder{color:#747570}.proposal-form input:focus,.proposal-form select:focus{border-color:var(--orange)}.proposal-form .button{width:100%;margin-top:6px;cursor:pointer}.proposal-form>small{color:#7f807a;font-size:.64rem;line-height:1.5;text-align:center}.problem-section{display:grid;grid-template-columns:90px minmax(0,.9fr) minmax(340px,.72fr);gap:clamp(36px,6vw,95px);padding:88px var(--side) 94px;border-bottom:1px solid var(--line)}.section-index{color:var(--orange-dark);font-family:ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,monospace;font-size:.72rem}.problem-heading h2{font-size:clamp(2.8rem,5vw,5rem)}.problem-content{padding-top:38px}.large-copy{margin-bottom:42px;color:#4b4b45;font-size:clamp(1.15rem,1.8vw,1.42rem);line-height:1.55}.comparison{border-top:1px solid #aaa79e}.comparison>div{display:grid;grid-template-columns:150px 1fr;gap:20px;padding:22px 0;border-bottom:1px solid var(--line)}.comparison span{color:#77776f;font-size:.72rem;font-weight:700;text-transform:uppercase}.comparison ul{display:grid;gap:8px;margin-bottom:0;padding:0;list-style:none}.comparison li{color:#55554e;font-size:.86rem}.comparison li:before{content:"×";display:inline-block;width:18px;color:#9d4230}.comparison-positive li:before{content:"✓";color:var(--orange-dark);font-weight:800}.trust-section{display:grid;grid-template-columns:minmax(320px,.82fr) minmax(500px,1fr);gap:clamp(50px,8vw,130px);padding:86px var(--side) 94px;border-bottom:1px solid var(--dark-line)}.trust-heading h2{margin:0;font-size:clamp(2.7rem,4.8vw,4.9rem);font-weight:620;letter-spacing:-.06em;line-height:.98}.trust-story>p{max-width:720px;margin:4px 0 35px;color:#c6c7c1;font-size:clamp(1.05rem,1.6vw,1.3rem);line-height:1.58}.trust-path{border-top:1px solid var(--dark-line)}.trust-path article{display:grid;grid-template-columns:38px minmax(150px,.65fr) 1fr;gap:20px;align-items:center;padding:20px 0;border-bottom:1px solid var(--dark-line)}.trust-path article>span{color:var(--orange);font-family:ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,monospace;font-size:.62rem}.trust-path b{font-size:.88rem}.trust-path small{color:#92938d;font-size:.76rem;line-height:1.55}.section-topline{display:flex;justify-content:space-between;gap:34px;align-items:end;padding-bottom:20px;border-bottom:1px solid #aaa79e}.section-topline>span,.deliverables-heading>span,.faq-heading>span{color:var(--orange-dark);font-family:ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,monospace;font-size:.7rem;font-weight:700;letter-spacing:.08em;text-transform:uppercase}.section-topline>p{max-width:490px;margin-bottom:0;color:var(--muted);font-size:.86rem}.website-anatomy{padding:86px var(--side) 94px}.anatomy-grid{display:grid;grid-template-columns:200px minmax(0,1fr);gap:clamp(28px,4vw,58px);align-items:start;padding-top:46px}.anatomy-nav{display:grid;border-top:1px solid var(--line)}.anatomy-nav button{display:grid;grid-template-columns:30px 1fr auto;gap:8px;align-items:center;min-height:56px;padding:0;border-bottom:1px solid var(--line);background:transparent;color:#77776f;cursor:pointer;text-align:left;transition:color .16s ease,padding-left .16s ease}.anatomy-nav button span{font-family:ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,monospace;font-size:.65rem}.anatomy-nav button b{font-size:.8rem}.anatomy-nav button i{color:transparent;font-style:normal}.anatomy-nav button:hover,.anatomy-nav button.active{padding-left:8px;color:var(--text)}.anatomy-nav button.active i{color:var(--orange-dark)}.anatomy-stage{display:grid;grid-template-columns:minmax(250px,.55fr) minmax(450px,1fr);gap:clamp(26px,3.5vw,54px);align-items:center;padding:30px;border:1px solid #b8b5ac;background:#ebe8df}.anatomy-copy>span{color:var(--orange-dark);font-family:ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,monospace;font-size:.67rem;font-weight:700;text-transform:uppercase}.anatomy-copy h2{margin:22px 0 18px;font-size:clamp(2rem,3.2vw,3.35rem);font-weight:620;letter-spacing:-.055em;line-height:1.02}.anatomy-copy p{max-width:520px;margin-bottom:0;color:var(--muted);font-size:1rem;line-height:1.7}.anatomy-preview{--orange: #b7ff32;border:1px solid #a7a49b;background:var(--white);box-shadow:12px 12px #d6d2c8}.capability-list{display:grid;grid-template-columns:repeat(4,1fr);margin-top:38px;border-top:1px solid #aaa79e;border-left:1px solid #aaa79e}.capability-list span{min-height:58px;padding:20px 16px;border-right:1px solid #aaa79e;border-bottom:1px solid #aaa79e;color:#55554e;font-size:.75rem;font-weight:700;text-align:center}.browser-bar{display:grid;grid-template-columns:repeat(3,7px) 1fr;gap:6px;align-items:center;height:34px;padding:0 11px;border-bottom:1px solid #c9c6bd;background:#ebe8df}.browser-bar>span{width:7px;height:7px;border:1px solid #89877f;border-radius:50%}.browser-bar small{justify-self:end;color:#77766f;font-size:.58rem}.demo-page{min-height:450px;padding:22px;background:#050605;color:var(--white)}.demo-header{display:flex;justify-content:space-between;gap:20px;align-items:center;padding-bottom:16px;border-bottom:1px solid #393a35}.demo-header b{color:var(--orange);font-size:.65rem;letter-spacing:.11em}.demo-header span{color:#9b9c96;font-size:.57rem}.demo-kicker{margin:38px 0 12px;color:var(--orange);font-family:ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,monospace;font-size:.58rem;letter-spacing:.09em;text-transform:uppercase}.demo-page h3{max-width:470px;margin-bottom:0;font-size:clamp(1.8rem,3.1vw,3rem);font-weight:600;letter-spacing:-.055em;line-height:1}.demo-intro-copy h3{font-size:clamp(2.25rem,4.4vw,4.6rem);font-weight:790;text-transform:uppercase}.demo-intro-copy h3 span{color:var(--white)}.demo-intro-copy h3{color:var(--orange)}.demo-intro-copy ul{display:grid;gap:5px;margin:17px 0 0;padding:0;color:var(--orange);font-size:.66rem;list-style:none}.demo-intro-copy li:before{content:"✓";margin-right:6px}.demo-intro-copy>p:not(.demo-kicker),.demo-contact>p:not(.demo-kicker),.demo-about-grid p{max-width:400px;margin:18px 0 0;color:#b3b4ae;font-size:.75rem;line-height:1.6}.demo-page button{margin-top:24px;padding:11px 15px;border:1px solid var(--orange);background:var(--orange);color:var(--ink);font-size:.67rem;font-weight:800}.demo-stat-line{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin-top:54px;padding-top:17px;border-top:1px solid #393a35;color:#8d8e88;font-size:.56rem;text-transform:uppercase}.demo-service-list{display:grid;margin-top:34px;border-top:1px solid #454640}.demo-service-list>div{display:grid;grid-template-columns:32px 1fr auto;gap:12px;align-items:center;padding:17px 0;border-bottom:1px solid #454640}.demo-service-list span{color:var(--orange);font-size:.58rem}.demo-service-list b{font-size:.77rem}.demo-service-list small{color:#898a84;font-size:.56rem}.demo-result-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-top:26px}.result-portrait{position:relative;min-height:150px;overflow:hidden;border:1px solid #4a4b46;background:#242520}.result-portrait:before,.result-portrait:after{position:absolute;content:""}.result-portrait:before{top:24px;left:50%;width:48px;height:48px;border:1px solid #696a64;border-radius:50%;transform:translate(-50%)}.result-portrait:after{right:20%;bottom:-32px;left:20%;height:90px;border:1px solid #696a64;border-bottom:0;border-radius:50% 50% 0 0}.result-two{background:#19220f}.result-portrait span{position:absolute;right:9px;bottom:9px;z-index:2;padding:5px 7px;background:var(--orange);color:var(--ink);font-size:.58rem;font-weight:800}.demo-case-note{margin:18px 0 0;padding-left:12px;border-left:2px solid var(--orange)}.demo-case-note small{color:var(--orange);font-size:.55rem;font-weight:800;text-transform:uppercase}.demo-case-note p{max-width:470px;margin:6px 0 0;color:#b8b9b3;font-size:.69rem;line-height:1.5}.demo-about-grid{display:grid;grid-template-columns:.7fr 1.3fr;gap:26px;align-items:center;min-height:390px}.demo-coach-mark{display:grid;aspect-ratio:.78;place-items:center;border:1px solid #555650;background:#252620;color:var(--orange);font-size:3.2rem;font-weight:800;letter-spacing:-.08em}.demo-about-grid .demo-kicker{margin-top:0}.demo-about-grid h3{font-size:clamp(1.65rem,2.7vw,