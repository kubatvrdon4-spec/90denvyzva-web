const MAX_FIELD_LENGTH = 4_000;

const cleanField = (value) => String(value ?? "").trim().slice(0, MAX_FIELD_LENGTH);

const isValidSessionId = (value) => /^[a-zA-Z0-9_-]{8,80}$/.test(String(value ?? ""));

export async function logChatEntry(entry) {
  const webhookUrl = process.env.GOOGLE_SHEETS_WEBHOOK_URL;
  const secret = process.env.CHAT_LOG_SECRET;

  if (!webhookUrl || !secret) {
    return;
  }

  const payload = {
    secret,
    timestamp: new Date().toISOString(),
    sessionId: isValidSessionId(entry.sessionId) ? entry.sessionId : "nezname",
    type: cleanField(entry.type || "Zprava"),
    question: cleanField(entry.question),
    answer: cleanField(entry.answer),
    action: cleanField(entry.action),
    page: "90denvyzva.cz",
  };

  const controller = new AbortController();
  const timeout = setTimeout(() => controller.abort(), 3_000);

  try {
    const result = await fetch(webhookUrl, {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify(payload),
      redirect: "follow",
      signal: controller.signal,
    });

    const responseBody = await result.json().catch(() => ({}));

    if (!result.ok || responseBody?.ok !== true) {
      console.error("Chat log webhook failed", result.status);
    }
  } catch (error) {
    console.error("Chat log webhook unavailable", error instanceof Error ? error.message : "unknown_error");
  } finally {
    clearTimeout(timeout);
  }
}
